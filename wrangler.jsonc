// Cloudflare Worker that only serves the static files in public/. No worker script, no build step.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "anka-play",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // Any unknown address shows the one page (the app finds its screen after "#").
    "not_found_handling": "single-page-application",
    // /datenschutz/ serves datenschutz/index.html.
    "html_handling": "auto-trailing-slash"
  },
  // Preview links for pull requests: the same settings as above.
  "previews": {},
  // Nothing to log: no code runs, and no tracking.
  "observability": { "enabled": false }
}
